{
  "expo": {
    "name": "HOUSE HELP Partner",
    "slug": "house-help-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "house-help-partner",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.househelp.provider",
      "buildNumber": "1",
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HOUSE HELP Partner uses your location only while you share progress for an assigned active booking.",
        "NSCameraUsageDescription": "Take profile, service, and identity-verification photos.",
        "NSPhotoLibraryUsageDescription": "Select profile, service, and identity-verification images.",
        "NSUserNotificationsUsageDescription": "Receive booking, payment, safety, and support updates.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.househelp.provider",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.CALL_PHONE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#176B5B"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAF9"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HOUSE HELP Partner uses your location only while you share progress for an assigned active booking.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#176B5B",
          "defaultChannel": "booking-updates"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": false,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4",
            "privacyManifestAggregationEnabled": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow HOUSE HELP to protect your signed-in session."
        }
      ]
    ]
  }
}
